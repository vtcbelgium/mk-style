/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=()
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src https://www.openstreetmap.org; upgrade-insecure-requests

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/js/main.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/js/admin-v2.js
  Cache-Control: no-store

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin/
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/agents.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/.well-known/agents.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
