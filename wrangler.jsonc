{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mk-style",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mk-style-staging",
      "database_id": "e6b9996b-30fc-4eda-86cd-fb5fae427cef"
    }
  ],
  "vars": {
    "STAGING_GATE_REQUIRED": "true"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mk-style-staging",
          "database_id": "e6b9996b-30fc-4eda-86cd-fb5fae427cef"
        }
      ],
      "vars": {
        "STAGING_GATE_REQUIRED": "true"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mk-style-production",
          "database_id": "b803618e-abef-48ef-9e49-cf8fbbbe9cea"
        }
      ],
      "vars": {
        "STAGING_GATE_REQUIRED": "false"
      }
    }
  }
}
